# --- Подключения ---
# ВАЖНО: compose подставляет эти URL в контейнеры api и bot.
# В docker-сети имена хостов — mongo и redis (дефолт ниже уже правильный).
# localhost-варианты — только для запуска бэка без docker (run.sh поднимает
# mongo/redis в compose, поэтому localhost тоже подходит: порты проброшены).
MONGO_URL=mongodb://mongo:27017/schoolhub
REDIS_URL=redis://redis:6379/0

# --- Безопасность ---
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- VK ---
VK_TOKEN=
VK_GROUP_ID=0

# --- Порты (docker compose и run.sh читают этот файл сами) ---
MONGO_PORT=27017
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=80
