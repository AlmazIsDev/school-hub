# --- Подключения ---
# compose подставляет эти URL в контейнеры api и bot как есть.
# ВАЖНО: localhost внутри контейнера — это сам контейнер, а не сервер!
# Mongo/Redis, живущие на хост-машине, адресуются через host.docker.internal:
#   MONGO_URL=mongodb://host.docker.internal:27027/schoolhub
# Соседние контейнеры compose — по имени сервиса:
#   MONGO_URL=mongodb://mongo:27017/schoolhub
MONGO_URL=mongodb://mongo:27017/schoolhub
REDIS_URL=redis://redis:6379/0

# --- Безопасность ---
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- VK ---
VK_TOKEN=
VK_GROUP_ID=0

# --- Порты (docker compose и run.sh читают этот файл сами) ---
MONGO_PORT=27017
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=80
